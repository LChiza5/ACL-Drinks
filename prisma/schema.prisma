generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth Models (NextAuth) ───────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  loyaltyPoints Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  addresses     Address[]
  orders        Order[]
  favorites     Favorite[]
  notifications Notification[]
  auditLogs     AuditLog[]
  couponUsages  CouponUsage[]
}

enum UserRole {
  ADMIN
  MANAGER
  CUSTOMER
}

// ─── Address ──────────────────────────────────────────────────────────────────

model Address {
  id         String  @id @default(cuid())
  userId     String
  alias      String  @default("Casa")
  fullName   String
  phone      String
  address    String
  district   String
  canton     String
  province   String
  postalCode String?
  notes      String?
  isDefault  Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  emoji       String?
  color       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Product ──────────────────────────────────────────────────────────────────

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?  @db.Text
  price          Float
  comparePrice   Float?
  images         String[]
  categoryId     String
  brand          String?
  alcoholContent Float?
  volume         String?
  country        String?
  sku            String?  @unique
  barcode        String?
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  isNew          Boolean  @default(false)
  isOnSale       Boolean  @default(false)
  tags           String[]
  metaTitle      String?
  metaDesc       String?

  category          Category           @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  kitProducts       KitProduct[]
  favorites         Favorite[]
  inventory         Inventory?
  promotionProducts PromotionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Kit ──────────────────────────────────────────────────────────────────────

model Kit {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String? @db.Text
  price        Float
  comparePrice Float?
  image        String?
  badge        String?
  isActive     Boolean @default(true)
  isFeatured   Boolean @default(false)

  kitProducts KitProduct[]
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KitProduct {
  id        String @id @default(cuid())
  kitId     String
  productId String
  quantity  Int    @default(1)

  kit     Kit     @relation(fields: [kitId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([kitId, productId])
}

// ─── Order ────────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  guestEmail      String?
  guestName       String?
  guestPhone      String?
  status          OrderStatus @default(PENDING)
  subtotal        Float
  discount        Float       @default(0)
  deliveryFee     Float       @default(0)
  total           Float
  notes           String?
  addressId       String?
  deliveryAddress Json?
  isDelivery      Boolean     @default(true)

  user         User?        @relation(fields: [userId], references: [id])
  address      Address?     @relation(fields: [addressId], references: [id])
  orderItems   OrderItem[]
  payment      Payment?
  shipment     Shipment?
  couponUsages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  kitId     String?
  name      String
  price     Float
  quantity  Int
  image     String?
  sku       String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  kit     Kit?     @relation(fields: [kitId], references: [id])
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Float
  currency      String        @default("CRC")
  transactionId String?
  reference     String?
  sinpePhone    String?
  metadata      Json?

  order Order @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentMethod {
  SINPE
  CREDIT_CARD
  DEBIT_CARD
  PAYPAL
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// ─── Shipment & Tracking ──────────────────────────────────────────────────────

model Shipment {
  id           String    @id @default(cuid())
  orderId      String    @unique
  carrier      String?
  trackingCode String?   @unique
  estimatedAt  DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  notes        String?

  order     Order      @relation(fields: [orderId], references: [id])
  trackings Tracking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tracking {
  id          String   @id @default(cuid())
  shipmentId  String
  status      String
  description String
  location    String?
  timestamp   DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id])
}

// ─── Promotions ───────────────────────────────────────────────────────────────

model Promotion {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        PromotionType
  value       Float
  minOrder    Float?
  maxDiscount Float?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean       @default(true)
  image       String?

  promotionProducts PromotionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
}

model PromotionProduct {
  id          String @id @default(cuid())
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([promotionId, productId])
}

// ─── Coupons ──────────────────────────────────────────────────────────────────

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  description String?
  type        CouponType
  value       Float
  minOrder    Float?
  maxUses     Int?
  usedCount   Int        @default(0)
  isActive    Boolean    @default(true)
  expiresAt   DateTime?

  couponUsages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  orderId  String
  userId   String?
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Inventory {
  id        String @id @default(cuid())
  productId String @unique
  stock     Int    @default(0)
  reserved  Int    @default(0)
  lowStock  Int    @default(5)
  sold      Int    @default(0)

  product Product @relation(fields: [productId], references: [id])

  updatedAt DateTime @updatedAt
}

// ─── Favorites ────────────────────────────────────────────────────────────────

model Favorite {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id      String           @id @default(cuid())
  userId  String
  title   String
  message String
  type    NotificationType @default(INFO)
  isRead  Boolean          @default(false)
  link    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ORDER_UPDATE
  PROMOTION
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ip        String?
  userAgent String?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
